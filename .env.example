# ---------- Database ----------
POSTGRES_DB=rmap
POSTGRES_USER=rmap
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# ---------- Backend API (ASP.NET Core) ----------
# Program.cs reads this via builder.Configuration.GetConnectionString("Default"). The backend
# runs outside docker compose (there is no api service above), so it connects to the db service
# through its published host port rather than the container's internal 5432. Host/port/database/
# username below match the db service's defaults from the Database section above; Password is
# left blank here, following this file's own convention (see POSTGRES_PASSWORD) — set it locally
# to whatever you set POSTGRES_PASSWORD to, never commit a real value.
ConnectionStrings__Default=Host=localhost;Port=5433;Database=rmap;Username=rmap;Password=

# ---------- Mail (Mailpit) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- pgAdmin (opt-in: docker compose --profile tools up -d) ----------
PGADMIN_EMAIL=dev@columbusglobal.example
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ---------- Microsoft Entra ID ----------
# Fill these in from docs/local-setup.md. Leave blank until the app registration exists.
AZUREAD__TENANTID=
AZUREAD__CLIENTID=
AZUREAD__AUDIENCE=
# Comma-separated. Empty means allow-any, which is honoured in Development only (OD-3).
AZUREAD__ALLOWEDEMAILDOMAINS=columbusglobal.com

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:5080
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_USE_MSW=true
