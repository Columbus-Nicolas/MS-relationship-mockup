# Copy to .env and choose new values. Never commit .env.
POSTGRES_DB=rmap
POSTGRES_USER=rmap
POSTGRES_PASSWORD=choose-a-new-one
POSTGRES_PORT=5433
ConnectionStrings__Default=Host=localhost;Port=5433;Database=rmap;Username=rmap;Password=choose-a-new-one

# Fills ICurrentUser from the X-Dev-User header instead of a real sign-in. The
# stub trusts any X-Dev-User that resolves to a Columbus user, with no secret,
# so anyone who can reach the API can act as anyone. Set it true for local
# development only, and never anywhere else — Entra replaces this stub later.
# Off is the fail-safe direction, and the reason this flag has to be set
# explicitly rather than following an environment merely labelled "Development".
DEV_AUTH=false
