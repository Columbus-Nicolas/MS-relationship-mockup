# ---------- Database ----------
POSTGRES_DB=rmap
POSTGRES_USER=rmap
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# ---------- Backend API (ASP.NET Core) ----------
# In Development the API parses this file itself at startup (see Configuration/EnvFile.cs), so
# `dotnet run` picks these values up with no shell sourcing. Do NOT run `set -a; source .env`
# instead: the connection string below contains semicolons, the shell reads them as command
# separators, and the value silently truncates to `Host=localhost`. Outside Development this
# file is ignored entirely and real environment variables are the only source.
#
# Program.cs reads this via builder.Configuration.GetConnectionString("Default"). The backend
# runs outside docker compose (there is no api service above), so it connects to the db service
# through its published host port rather than the container's internal 5432. Host/port/database/
# username below match the db service's defaults from the Database section above; Password is
# left blank here, following this file's own convention (see POSTGRES_PASSWORD) — set it locally
# to whatever you set POSTGRES_PASSWORD to, never commit a real value.
ConnectionStrings__Default=Host=localhost;Port=5433;Database=rmap;Username=rmap;Password=

# ---------- Local development mode ----------
# Turns on a local sign-in that replaces Microsoft Entra entirely: the API accepts an
# `X-Dev-Email` header instead of a bearer token, applies migrations and seeds the synthetic
# dataset on boot, adds a `dev@columbusglobal.example` account, and exposes GET /api/dev/session
# so the login page in index.html knows to offer a "Developer sign-in" button. With this off,
# none of that exists — the route 404s and the button never renders.
#
# It is an authentication bypass, so the API refuses to start if this is true anywhere other than
# Development (see Auth/DevModeGuard.cs). Leave it false unless you are working locally.
DEV_MODE=false

# ---------- Mail (Mailpit) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- pgAdmin (opt-in: docker compose --profile tools up -d) ----------
PGADMIN_EMAIL=dev@columbusglobal.example
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ---------- Microsoft Entra ID ----------
# Fill these in from docs/local-setup.md once the app registration exists.
# Left COMMENTED OUT, not blank. Environment variables outrank appsettings.json, so setting
# these to an empty string overrides the placeholder GUIDs that appsettings.json carries to keep
# the app bootable — and Microsoft.Identity.Web then throws IDW10106 on every single request
# (see the comment in Program.cs). Uncomment and fill in once the app registration exists.
#AZUREAD__TENANTID=
#AZUREAD__CLIENTID=
#AZUREAD__AUDIENCE=
# Comma-separated. Empty means allow-any, which is honoured in Development only (OD-3).
# Leave it EMPTY when running with DEV_MODE=true: every seeded account is @columbusglobal.example,
# so the value below would reject all of them at the domain gate.
AZUREAD__ALLOWEDEMAILDOMAINS=columbusglobal.com

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:5080
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_USE_MSW=true
