# Copy to .env and choose new values. Never commit .env.
POSTGRES_DB=rmap
POSTGRES_USER=rmap
POSTGRES_PASSWORD=choose-a-new-one
POSTGRES_PORT=5433
ConnectionStrings__Default=Host=localhost;Port=5433;Database=rmap;Username=rmap;Password=choose-a-new-one

# Fills ICurrentUser from the X-Dev-User header instead of a real sign-in.
# Must never be true outside development — Entra replaces this stub later.
DEV_AUTH=true
