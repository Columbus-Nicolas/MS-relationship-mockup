# ---------- Database ----------
POSTGRES_DB=rmap
POSTGRES_USER=rmap
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# ---------- Mail (Mailpit) ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- pgAdmin (opt-in: docker compose --profile tools up -d) ----------
PGADMIN_EMAIL=dev@columbusglobal.example
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ---------- Microsoft Entra ID ----------
# Fill these in from docs/local-setup.md. Leave blank until the app registration exists.
AZUREAD__TENANTID=
AZUREAD__CLIENTID=
AZUREAD__AUDIENCE=
# Comma-separated. Empty means allow-any, which is honoured in Development only (OD-3).
AZUREAD__ALLOWEDEMAILDOMAINS=columbusglobal.com

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:5080
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_USE_MSW=true
