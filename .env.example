# Copy to .env and fill in. .env is git-ignored: never commit it.

# From the Entra app registration (README, "Sign-in").
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# 32 random bytes:  openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Made Admin the first time they sign in (comma separated).
ADMIN_EMAILS=nicolas.bentmann@columbusglobal.com
